# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.venv/
venv/
env/

# Projeto
config.txt
placas.db
placas.db-journal
placas.db-wal
placas.db-shm
*.log
# rotacionados por log_arquivo_backups: alpr.log.1, .2, .3
*.log.[0-9]*

# Modelos (baixados no entrypoint)
models/*.onnx
models/*.pt

# Snapshots e mídia
app/web/static/snapshots/*
!app/web/static/snapshots/.gitkeep

# Preview de bico (fora de static/ de propósito, ver app/visao/leitura.py:PREVIEW_DIR) —
# mesma foto de placa, mesmo motivo de não versionar.
app/web/dados_privados/

# IDE
.vscode/
.idea/
.claude/
*.swp
.DS_Store

# Docker
.env

# Clone incompleto aninhado (só .git + .gitattributes/.gitignore), aponta para
# o mesmo repositório remoto. Ignorado para não virar submódulo por acidente.
leitura-placas/

# Backups e cópias de banco/config (contêm senhas, hashes e dados de cliente)
*.bak
placas.db.*
config.txt.*

# Saídas da suíte de testes e logs transitórios
testes/resultados/
testes/log*.txt
scratch/
scratch_*.pkl
out[0-9]*.txt

# Rótulos das cenas reais (avalia_cenas_reais.py): referenciam frames de câmera
# com pessoas e placas de clientes — ficam só na máquina, como os snapshots.
testes/cenas_reais.json

# Fila de classificação: quais capturas um operador recusou. É estado local, casado
# com os snapshots desta máquina (que também não são versionados).
testes/descartados.json

# Recortes reais que testes de aceitação abrem por nome (test_moto_duas_linhas_real.py).
# Vivem AQUI, e não em app/web/static/snapshots/, porque aquela pasta agora tem teto de
# contagem (retencao_max_imagens) e a purga apagaria a entrada do teste — que passaria a
# ser pulado em silêncio, deixando a regressão invisível. Fora de SNAPSHOT_DIR eles estão
# fora do alcance da purga por construção, não por lista de exceção.
# Continuam gitignored: são placa e veículo de cliente real, mesma política dos snapshots.
testes/reais/

# Marcador de "esta maquina ja foi configurada", escrito pelo INICIAR_ALPR.bat com a
# data/hora local. E estado da instalacao, nao do projeto.
.config_ok

# Prints da auditoria de UI/UX (scripts/prints_ui.py). Sao 12 MB de PNG regeneravel:
# rodar o script de novo produz os prints atualizados, e binario no historico do git nunca
# mais sai — mesmo argumento do ALPR.exe abaixo. O que fica versionado e a FONTE
# (scripts/prints_ui.py), que e o que permite reproduzir.
prints-revisao/

# Executavel do lancador (PyInstaller). NAO versionado de proposito: sao 7 MB de binario,
# e binario no historico do git nunca mais sai. Ele e ARTEFATO DE RELEASE — anexado ao
# release do GitHub, junto do ALPR-feira.zip. O que fica versionado e a FONTE dele
# (lancador.py) e o INICIAR_ALPR.bat, que e o que permite reconstruir.
ALPR.exe
*.spec
